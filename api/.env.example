# Copie para .env e ajuste. Todas as variáveis usam o prefixo AGRISHIELD_ (ver app/core/config.py).
AGRISHIELD_ENVIRONMENT=dev

# MQTT — precisa bater com TOPIC_PREFIX do firmware (iot/src/main.ino). Ver document/contrato-mqtt.md
AGRISHIELD_MQTT_HOST=broker.hivemq.com
AGRISHIELD_MQTT_PORT=1883
AGRISHIELD_MQTT_TOPIC_PREFIX=agrishield/fiap-sompo-2026
# false sobe a API sem ponte MQTT (é o que os testes fazem)
AGRISHIELD_MQTT_ENABLED=true
# Sufixo do client_id no broker. Vazio = um aleatório por processo, para duas instâncias da API
# não derrubarem uma à outra no broker público.
# AGRISHIELD_MQTT_CLIENT_ID_SUFFIX=
# Backoff da reconexão automática do paho, em segundos
AGRISHIELD_MQTT_RECONNECT_MIN_S=1
AGRISHIELD_MQTT_RECONNECT_MAX_S=30
# Keepalive MQTT: quanto menor, mais rápido a API percebe que o broker caiu (15 s ≈ 22 s)
AGRISHIELD_MQTT_KEEPALIVE_S=15
# W4 — de quanto em quanto tempo a API republica o limite do dia (1 h)
AGRISHIELD_MQTT_PUBLISH_INTERVAL_S=3600

# Segurança (I5, ADR-013) — chaves aceitas em X-API-Key, separadas por vírgula.
# Obrigatória para publicar limite e consultar /api/v1/audit.
# Vazio = nenhuma escrita é aceita (falha fechada). NUNCA commite a chave real.
AGRISHIELD_API_KEYS=troque-esta-chave
# Por quantos dias a trilha de auditoria é mantida (limpeza no boot)
AGRISHIELD_DECISION_RETENTION_DAYS=30

# Banco local em SQLite (ADR-009). O arquivo .db está no .gitignore.
AGRISHIELD_DATABASE_URL=sqlite:///./agrishield.db
