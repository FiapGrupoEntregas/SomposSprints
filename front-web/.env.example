# Copie para `front-web/.env` e preencha. O front carrega esse arquivo no início (config.py).
# Variável já exportada no terminal **vence** o que está aqui.

# URL base da API (sem /api/v1).
AGRISHIELD_API_URL=http://localhost:8000

# Chave de API usada nas escritas protegidas (hoje: "Enviar ao equipamento", I5).
# Precisa ser uma das chaves da lista AGRISHIELD_API_KEYS configurada na api/.
# Sem ela, a leitura continua funcionando e só o envio do limite é recusado com 401.
AGRISHIELD_API_KEY=troque-esta-chave
