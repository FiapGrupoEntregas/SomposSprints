# Dados tabulares (não versionar datasets brutos)
*.csv
*.tsv
*.xls
*.xlsx
# Exceções: a amostra anonimizada (D1) e os fixtures de teste são pequenos e vão para o Git
!data/sample/*.csv
!api/tests/fixtures/*.csv

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Segredos e configuração local
.env
.streamlit/secrets.toml

# Dados brutos baixados por script (ver document/dados-e-modelo.md)
data/raw/

# Parcial da geração do dataset (D2): reconstruível, e só serve para retomar
data/.dataset_parcial.jsonl

# Banco local (I3)
*.db
*.sqlite3

# PlatformIO / IoT
.pio/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Claude Code (configuração pessoal; agentes e skills em .claude/ são versionados)
.claude/settings.local.json

# SO e editores
.DS_Store
Thumbs.db
.idea/
